<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ site_title }}</title>
  <style>
    :root {
      color-scheme: dark;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      color: #eef6ff;
      background:
        radial-gradient(circle at 15% 20%, rgba(32, 162, 255, 0.28), transparent 28rem),
        radial-gradient(circle at 85% 80%, rgba(78, 255, 188, 0.18), transparent 30rem),
        #07111f;
    }

    main {
      width: min(880px, calc(100% - 2rem));
      padding: clamp(2rem, 7vw, 5rem);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: 28px;
      background: rgba(10, 25, 43, 0.78);
      box-shadow: 0 28px 80px rgba(0, 0, 0, 0.32);
      backdrop-filter: blur(18px);
    }

    .eyebrow {
      margin: 0 0 1rem;
      color: #50e3b5;
      font-weight: 800;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    h1 {
      margin: 0;
      font-size: clamp(3rem, 10vw, 6.8rem);
      line-height: 0.94;
      letter-spacing: -0.065em;
    }

    .summary {
      max-width: 58ch;
      margin: 1.5rem 0 2.25rem;
      color: #b9cce2;
      font-size: 1.1rem;
      line-height: 1.7;
    }

    .details {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 1rem;
    }

    .detail {
      padding: 1rem;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.055);
    }

    .label {
      display: block;
      margin-bottom: 0.35rem;
      color: #7891ad;
      font-size: 0.78rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .value {
      font-weight: 700;
    }
  </style>
</head>
<body>
  <main>
    <p class="eyebrow">{{ site_title }}</p>
    <h1>Hello, World!</h1>
    <p class="summary">
      AWS infrastructure provisioned with Terraform. Nginx installed,
      configured, and verified with an idempotent Ansible playbook.
    </p>
    <section class="details" aria-label="Deployment details">
      <div class="detail">
        <span class="label">Environment</span>
        <span class="value">{{ deployment_environment | upper }}</span>
      </div>
      <div class="detail">
        <span class="label">Host</span>
        <span class="value">{{ ansible_hostname }}</span>
      </div>
      <div class="detail">
        <span class="label">Version</span>
        <span class="value">{{ site_version }}</span>
      </div>
    </section>
  </main>
</body>
</html>
