aws_region       = "us-east-1"
project_name     = "tech-challenge-3"
environment      = "dev"
instance_type    = "t3.micro"

# Replace this example address with your public IPv4 address followed by /32.
# Never use 0.0.0.0/0 for SSH.
ssh_cidr = "203.0.113.10/32"

public_key_path  = "~/.ssh/tech-challenge-3.pub"
private_key_path = "~/.ssh/tech-challenge-3"

# This is convenient for a temporary lab because terraform destroy can remove
# archived logs. Set it to false for a bucket that must be protected.
force_destroy_bucket = true
